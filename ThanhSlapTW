local function GetTargetPlayers()
    local list = {}
    if targetName == "" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(list, p) end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Name:lower():find(targetName:lower()) then
                table.insert(list, p)
            end
        end
    end
    return list
end

