local spamSlapActive = false
AddBtn("4. Spam Tát Hất Văng Toàn Server (Mọi Găng Tay)", function(st)
    spamSlapActive = st
    task.spawn(function()
        while spamSlapActive do
            task.wait(0.01)
            if not spamSlapActive then break end
            pcall(function()
                for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
                    if not spamSlapActive then break end
                    if obj:IsA("RemoteEvent") then
                        local name = obj.Name:lower()
                        if name:find("slap") or name:find("hit") or name:find("punch") or name:find("attack") or name:find("ability") or name:find("skill") or name:find("power") then
                            pcall(function()
                                obj:FireServer()
                                obj:FireServer(true)
                                local char = LocalPlayer.Character
                                local root = char and char:FindFirstChild("HumanoidRootPart")
                                if root then
                                    obj:FireServer(root)
                                end
                                for _, p in ipairs(Players:GetPlayers()) do
                                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                                        obj:FireServer(p.Character.HumanoidRootPart)
                                        obj:FireServer(p.Character)
                                    end
                                end
                            end)
                        end
                    end
                end

                local bp = LocalPlayer:FindFirstChild("Backpack")
                if bp then
                    for _, item in ipairs(bp:GetChildren()) do
                        if item:IsA("Tool") then
                            for _, desc in ipairs(item:GetDescendants()) do
                                if desc:IsA("RemoteEvent") then
                                    pcall(function()
                                        desc:FireServer()
                                        desc:FireServer(true)
                                        for _, p in ipairs(Players:GetPlayers()) do
                                            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                                                desc:FireServer(p.Character.HumanoidRootPart)
                                            end
                                        end
                                    end)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)
    ShowNotif(st and "[✓] Bật Spam Tát (Mọi Găng Tay)" or "[✗] Tắt Spam Tát")
end)


